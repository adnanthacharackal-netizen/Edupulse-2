# .env.example
# EduPulse Student Hub - Supabase Configuration
# Get these values from your Supabase Dashboard:
# Project -> Project Settings (gear icon) -> API

# Your unique Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public API Key (safe to use in browser)
# NEVER put your 'service_role' secret key here!
VITE_SUPABASE_ANON_KEY=your-anon-public-key
